{
  "name": "zbase-cardano-mainnet",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*",
    "services/*",
    "circuits",
    "ops",
    "examples/*",
    "apps/web",
    "apps/docs"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p contracts/fixtures",
    "check:contracts": "cd contracts && aiken check",
    "build:contracts": "cd contracts && aiken build",
    "build:circuits": "bash circuits/scripts/build.sh",
    "setup:dev": "node circuits/scripts/setup-dev.mjs",
    "ops:setup": "npm run setup -w ops --",
    "ops:deploy": "npm run deploy -w ops --",
    "check:budgets": "node contracts/scripts/check-budgets.mjs",
    "fixtures": "node --import tsx contracts/fixtures/gen.ts",
    "check:fixtures": "node --import tsx contracts/fixtures/gen.ts --check",
    "test:smoke": "node --import tsx --test scripts/smoke.test.ts",
    "dev": "npm run dev --workspace @zbase/web",
    "build": "npm run build --workspace @zbase/web",
    "preview": "npm run preview --workspace @zbase/web",
    "docs:dev": "npm run dev --workspace @zbase/docs",
    "docs:build": "npm run build --workspace @zbase/docs"
  },
  "devDependencies": {
    "@aiken-lang/aiken": "1.1.24",
    "@aiken-lang/merkle-patricia-forestry": "1.3.1",
    "@evolution-sdk/evolution": "0.5.17",
    "@meshsdk/core": "1.9.1",
    "@meshsdk/core-cst": "1.9.1",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@scure/base": "1.2.6",
    "@types/node": "22.20.5",
    "@types/snarkjs": "0.7.9",
    "@x402/cardano": "2.28.0",
    "@x402/core": "2.28.0",
    "@x402/fetch": "2.28.0",
    "circom2": "0.2.23",
    "poseidon-bls12381": "1.0.2",
    "poseidon-bls12381-circom": "1.0.0",
    "snarkjs": "0.7.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "nextra": {
      "zod": "4.3.6"
    },
    "nextra-theme-docs": {
      "zod": "4.3.6"
    }
  }
}
